-- Interactive CPS Counter Script with GUI
-- Displays CPS (Clicks Per Second) on a GUI in real-time with faster updates and decay.

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local clicks = 0
local startTime = os.clock()
local decayRate = 2 -- Increased CPS decay rate per second for faster decay
local incrementPerClick = 2 -- Number of clicks to increment per mouse click for faster CPS increase

-- Create the GUI
local screenGui = Instance.new("ScreenGui")
local textLabel = Instance.new("TextLabel")

-- Configure the GUI
screenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
textLabel.Parent = screenGui
textLabel.Size = UDim2.new(0, 200, 0, 50)
textLabel.Position = UDim2.new(0.5, -100, 0.1, 0) -- Centered at the top
textLabel.BackgroundColor3 = Color3.new(0, 0, 0)
textLabel.TextColor3 = Color3.new(1, 1, 1)
textLabel.TextSize = 24
textLabel.Text = "CPS: 0.00"

-- Function to calculate and update CPS
local function calculateCPS()
    local elapsedTime = os.clock() - startTime

    if elapsedTime > 0 then
        local cps = clicks / elapsedTime
        textLabel.Text = "CPS: " .. string.format("%.2f", cps)
        return cps
    end

    return 0
end

-- Coroutine to handle CPS decay over time
local function startDecaying()
    while true do
        RunService.RenderStepped:Wait()

        local currentText = textLabel.Text
        local currentCPS = tonumber(currentText:match("CPS: ([%d%.]+)"))

        if currentCPS and currentCPS > 0 then
            local newCPS = math.max(0, currentCPS - decayRate * RunService.RenderStepped:Wait())
            textLabel.Text = "CPS: " .. string.format("%.2f", newCPS)
        end
    end
end

-- Start the decay coroutine
coroutine.wrap(startDecaying)()

-- Function to reset CPS calculation
local function resetCPS()
    clicks = 0
    startTime = os.clock()
    textLabel.Text = "CPS: 0.00"
end

-- Detect left mouse button clicks
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton1 then
        clicks = clicks + incrementPerClick -- Increase clicks by a larger amount
        calculateCPS()
    end
end)

-- Expose interactive functions globally (optional)
_G.resetCPS = resetCPS

-- Instructions for the user
print("Interactive CPS Counter with GUI Initialized.")
print("Click your left mouse button to see the CPS update in real-time.")
print("The CPS will now increase faster and decrease faster when you stop clicking.")
print("Type '_G.resetCPS()' in the console to reset the CPS counter.")
