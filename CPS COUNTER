-- Define a function to calculate CPS
local function calculateCPS(cpsDisplay)
    local clicks = 0
    local lastTick = os.clock()  -- Using os.clock() for higher precision

    -- Function to increment clicks and calculate CPS
    local function onClick()
        clicks = clicks + 1
        local currentTick = os.clock()
        local elapsedTime = currentTick - lastTick

        if elapsedTime > 1 then
            local cps = clicks / elapsedTime
            cpsDisplay.Text = "CPS: " .. string.format("%.2f", cps)
            clicks = 0
            lastTick = currentTick
        end
    end

    -- Function to reset clicks and CPS display
    local function reset()
        clicks = 0
        lastTick = os.clock()
        cpsDisplay.Text = "CPS: 0"
    end

    return onClick, reset
end

-- Create a GUI display to show the CPS
local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
if not playerGui then
    warn("PlayerGui not found! Ensure the script is running as a LocalScript.")
    return
end

-- CPS Display
local cpsDisplay = Instance.new("TextLabel")
cpsDisplay.Parent = playerGui
cpsDisplay.Size = UDim2.new(0.2, 0, 0.1, 0) -- Scales dynamically
cpsDisplay.Position = UDim2.new(0.4, 0, 0.1, 0) -- Centered horizontally
cpsDisplay.Text = "CPS: 0"
cpsDisplay.TextColor3 = Color3.new(1, 1, 1)
cpsDisplay.BackgroundColor3 = Color3.new(0, 1, 0)

-- Functions for handling clicks and resets
local onClick, reset = calculateCPS(cpsDisplay)

-- Reset Button
local resetButton = Instance.new("TextButton")
resetButton.Parent = playerGui
resetButton.Size = UDim2.new(0.2, 0, 0.1, 0) -- Dynamic scaling
resetButton.Position = UDim2.new(0.4, 0, 0.25, 0) -- Adjusted dynamic scaling
resetButton.Text = "Reset"
resetButton.TextColor3 = Color3.new(1, 1, 1)
resetButton.BackgroundColor3 = Color3.new(1, 0, 0)
resetButton.MouseButton1Click:Connect(function()
    reset()
    print("CPS reset to 0")
end)

-- Click Me Button
local button = Instance.new("TextButton")
button.Parent = playerGui
button.Size = UDim2.new(0.2, 0, 0.1, 0) -- Dynamic scaling
button.Position = UDim2.new(0.4, 0, 0.4, 0) -- Adjusted dynamic scaling
button.Text = "Click Me!"
button.TextColor3 = Color3.new(1, 1, 1)
button.BackgroundColor3 = Color3.new(0, 1, 0)
button.MouseButton1Click:Connect(onClick)

-- Add hover effect for buttons
local function addHoverEffect(button)
    local originalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8) -- Light gray
    end)
    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = originalColor
    end)
end

addHoverEffect(resetButton)
addHoverEffect(button)
